{
  "manifest_version": 3,
  "name": "SIMNET Workbench",
  "version": "1.7.36.117",
  "description": "SIMNET Workbench: facts + visits + direct if/else actions, without continuous page rescanning.",
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://userside.simnet.kiev.ua/*",
    "https://admin.simnet.kiev.ua/*",
    "https://admin.looknet.kiev.ua/*",
    "https://pbx.simnet.kiev.ua/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "src/background-entry.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://userside.simnet.kiev.ua/*",
        "https://admin.simnet.kiev.ua/*",
        "https://admin.looknet.kiev.ua/*"
      ],
      "js": [
        "src/content/namespace.js",
        "src/ui/debug-log.js",
        "src/core/event-bus.js",
        "src/core/click-debug.js",
        "src/core/junction-debug.js",
        "src/parsers/billing/poll-result.js",
        "src/parsers/billing/technical.js",
        "src/parsers/userside/tmc.js",
        "src/parsers/userside/building-core.js",
        "src/core/billing-navigation.js",
        "src/core/page-context.js",
        "src/readers/billing.js",
        "src/readers/userside.js",
        "src/browser/actions/focus-userside-tmc.js",
        "src/core/interaction-guards.js",
        "src/core/store-client.js",
        "src/ui/case-view.js",
        "src/core/evidence-navigator.js",
        "src/ui/knowledge-loader.js",
        "src/core/juniper-prefetch.js",
        "src/core/handoff.js",
        "src/ui/poll-terminal-loader.js",
        "src/ui/call-registration-loader.js",
        "src/ui/call-transcription-assistant.js",
        "src/ui/call-pbx-diagnostic.js",
        "src/ui/task-form-assistant.js",
        "src/ui/operator-companion-loader.js",
        "src/ui/rail-styles.js",
        "src/ui/rail.js",
        "src/ui/call-attention-bridge.js",
        "src/ui/call-console-diagnostics.js",
        "src/ui/call-pbx-recovery.js",
        "src/ui/call-userside-link.js",
        "src/ui/call-error-context-ui.js",
        "src/ui/settings-enhancer.js",
        "src/ui/responsive-layout.js",
        "src/content/bootstrap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pbx.simnet.kiev.ua/*"
      ],
      "js": [
        "src/pbx/pbx-manual-analysis-ui.js",
        "src/pbx/pbx-workbench-shell.js",
        "src/pbx/pbx-error-diagnostics.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SIMNET Workbench",
    "default_popup": "src/ui/popup.html"
  },
  "options_ui": {
    "page": "src/ui/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/parsers/userside/tmc.js"
      ],
      "matches": [
        "https://userside.simnet.kiev.ua/*",
        "https://admin.simnet.kiev.ua/*",
        "https://admin.looknet.kiev.ua/*"
      ]
    }
  ],
  "version_name": "1.7.36.117-transcriber-8090-health-probe",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
